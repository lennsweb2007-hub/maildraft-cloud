# ============================================================================
#  MailDraft AI - Cloud
#
#  Diese Werte in Vercel unter Settings > Environment Variables eintragen,
#  NICHT in eine Datei im Projekt. Fuer "vercel dev" lokal eine .env anlegen -
#  die steht in der .gitignore.
#
#  Nur Werte mit dem Praefix VITE_ landen im Browser. Alles andere bleibt auf
#  dem Server. Der SERVICE_ROLE_KEY darf NIEMALS mit VITE_ beginnen - er
#  umgeht saemtliche Zugriffsregeln der Datenbank.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase  (Dashboard > Project Settings > API)
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Serverseitig. Umgeht Row Level Security - nur in Vercel Functions verwenden.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ----------------------------------------------------------------------------
# PFLICHT: Verschluesselung der Postfach-Zugangsdaten
# ----------------------------------------------------------------------------
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ACHTUNG: Wird dieser Wert geaendert, muessen alle Postfaecher neu verbunden
# werden. In Vercel fuer Production, Preview und Development denselben Wert
# eintragen - sonst funktionieren Vorschau-Bereitstellungen nicht.
ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# PFLICHT: Google Gemini
# ----------------------------------------------------------------------------
# Ein gemeinsamer Schluessel fuer alle Nutzer. Kostenlos unter
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modell fuer die Entwuerfe - trifft nur die echten Kundenanfragen.
GEMINI_MODEL=gemini-3.6-flash

# Modell fuer die Relevanzpruefung - laeuft ueber JEDE eingehende Mail.
# Bewusst getrennt: Google fuehrt die Kontingente pro Modell, die Trennung
# entlastet also beide Grenzen. Und "ist das eine Kundenanfrage?" ist eine
# Aufgabe, fuer die ein kleines Modell reicht.
GEMINI_TRIAGE_MODEL=gemini-3.1-flash-lite

# Anfragen pro Minute ueber ALLE Nutzer hinweg. Der kostenlose Tarif erlaubt
# je nach Modell nur 15 bis 30 - nicht die oft genannten 60.
GEMINI_REQUESTS_PER_MINUTE=15

# ----------------------------------------------------------------------------
# Gmail  (Google Cloud Console > APIs & Services > Credentials)
# ----------------------------------------------------------------------------
# Anwendungstyp "Webanwendung". Autorisierter Redirect-URI:
#   https://DEINE-APP.vercel.app/api/accounts/callback?provider=gmail
# Fuer die lokale Entwicklung zusaetzlich:
#   http://localhost:3000/api/accounts/callback?provider=gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Outlook  (Azure Portal > App registrations)   OPTIONAL
# ----------------------------------------------------------------------------
# Redirect-URI: https://DEINE-APP.vercel.app/api/accounts/callback?provider=outlook
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# ----------------------------------------------------------------------------
# Adresse der App
# ----------------------------------------------------------------------------
# Ohne Schraegstrich am Ende. Wird fuer die OAuth-Rueckleitung gebraucht und
# muss zeichengenau zu dem passen, was bei Google bzw. Microsoft hinterlegt ist.
APP_URL=https://deine-app.vercel.app

# ----------------------------------------------------------------------------
# Cron  (EasyCron)
# ----------------------------------------------------------------------------
# Freies Geheimnis, erzeugen wie den ENCRYPTION_KEY. EasyCron muss es als
# Header "X-Cron-Secret" mitschicken - nicht als Query-Parameter, der stuende
# sonst in jedem Server-Log.
CRON_SECRET=

# Zeitbudget eines Abruf-Aufrufs in Millisekunden. Muss unter der maxDuration
# aus der vercel.json liegen; der Rest wird beim naechsten Cron-Lauf geholt.
SYNC_TIME_BUDGET_MS=45000

# Wie viele Mails ein Konto pro Aufruf hoechstens liefert.
MAX_EMAILS_PER_SYNC=40

# Wie weit beim ersten Abruf eines Kontos zurueckgeschaut wird (Tage).
INITIAL_LOOKBACK_DAYS=3

# Vorlauf vor dem letzten Abruf in Minuten. Faengt verspaetet zugestellte
# Mails und Uhrzeitunterschiede zum Mailserver ab; Doppelungen verhindert der
# Unique-Index in der Datenbank.
SYNC_OVERLAP_MINUTES=90
